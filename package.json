{
    "name": "retroflightsim",
    "description": "Simulating early 90s flight sim visuals",
    "version": "0.0.1",
    "scripts": {
        "pack-mods": "node tools/run-python.mjs tools/pack_aircraft_mods.py",
        "build": "webpack --mode=development && npm run pack-mods",
        "build:prod": "webpack --mode=production && npm run pack-mods",
        "start": "node tools/dev.mjs",
        "watch": "node tools/watch.mjs",
        "bake:airports": "node tools/run-python.mjs tools/bake_osm_airports.py",
        "verify:airports": "node tools/run-python.mjs tools/verify_airports.py",
        "bake:cover": "node tools/run-python.mjs tools/bake_planet_cover.py",
        "fetch:cover": "node tools/run-python.mjs tools/fetch_cover_sources.py",
        "fetch:dem": "node tools/run-python.mjs tools/fetch_planet_dem.py",
        "merge:dem": "node tools/run-python.mjs tools/merge_planet_dem.py",
        "bake:mesh": "node --import tsx tools/bake_planet_mesh.ts",
        "bake:errors": "node --import tsx tools/bake_planet_errors.ts",
        "bake:tex": "node --import tsx tools/bake_planet_tex.ts",
        "bake:roads": "node tools/run-python.mjs tools/bake_osm_roads.py",
        "bake:road-grade": "node --import tsx tools/bake_planet_roadgrade.ts",
        "bake:road-strokes": "node --import tsx tools/bake_planet_roads.ts",
        "bake:bridges": "node --import tsx tools/bake_planet_bridges.ts",
        "bake:tree-sprites": "node --import tsx tools/bake_tree_sprites.ts",
        "verify:planet": "node --import tsx tools/verify_planet.ts",
        "deploy:pages": "node tools/deploy-pages.mjs",
        "preserve": "npm run build",
        "serve": "tsx tools/modserver.ts",
        "test": "node --import tsx --test src/script/config/**/*.test.ts src/script/physics/**/*.test.ts src/script/ai/**/*.test.ts src/script/weapons/**/*.test.ts src/script/state/**/*.test.ts src/script/render/**/*.test.ts src/script/scene/**/*.test.ts src/script/planet/**/*.test.ts src/script/terrain/**/*.test.ts src/script/ui/**/*.test.ts tools/bake/**/*.test.ts tools/*.test.ts"
    },
    "author": "Ruben Moreno Montoliu <ruben3d@gmail.com>",
    "license": "MIT",
    "homepage": "https://github.com/ruben3d/retroflightsim",
    "dependencies": {
        "@angular/cdk": "~22.1.6",
        "@angular/common": "~22.1.6",
        "@angular/compiler": "~22.1.6",
        "@angular/core": "~22.1.6",
        "@angular/material": "~22.1.6",
        "@angular/platform-browser": "~22.1.6",
        "fflate": "~0.8.2",
        "rxjs": "~7.8.0",
        "three": "0.185.1",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular/compiler-cli": "~22.1.6",
        "@babel/core": "^8.0.5",
        "@ngtools/webpack": "~22.1.8",
        "@tailwindcss/postcss": "~4.3.3",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.2.0",
        "@types/three": "0.185.0",
        "babel-loader": "^10.1.1",
        "copy-webpack-plugin": "~14.0.0",
        "css-loader": "^7.1.5",
        "esbuild": "^0.28.1",
        "express": "^5.2.1",
        "local-web-server": "~5.4.0",
        "mini-css-extract-plugin": "^2.10.2",
        "multer": "^2.2.0",
        "postcss": "^8.5.28",
        "postcss-loader": "^8.2.1",
        "tailwindcss": "~4.3.3",
        "ts-loader": "~9.6.2",
        "tsx": "^4.23.0",
        "typescript": "~6.0.3",
        "webpack": "~5.108.4",
        "webpack-cli": "~7.2.1"
    }
}
